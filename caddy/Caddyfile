{
	email {$LETSENCRYPT_EMAIL}
	servers {
		max_header_size 16KB
	}
}

# Inner Caddy → nginx hop is HTTP-only by design: Caddy already terminates
# public TLS via Let's Encrypt; an inner mTLS layer would add complexity
# without buying anything for a single-machine compose stack. If a future
# multi-host deployment needs inner mTLS, see W1-4 in
# docs/plans/2026-05-07-post-audit-fix-sweep.md.
{$LETSENCRYPT_DOMAIN} {
	request_body {
		max_size 50MB
	}
	# Rate limiting: not in scope for single-user pre-launch.
	# See docs/plans/2026-05-07-deep-audit-security-review-v2.md W2-25.
	reverse_proxy http://dashboard:3000
}
