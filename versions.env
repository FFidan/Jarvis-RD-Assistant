# versions.env — tested image versions for JARVIS RD Assistant
# This file pins third-party Docker images to known-good versions.
# Maintainers bump these after testing upgrades; users pull updates via:
#   git pull && ./update.sh
#
# Rolling tags (main-stable, latest) are upstream-convention exceptions —
# bumped by the upstream registry, not by this file.

POSTGRES_IMAGE=postgres:16.8
OLLAMA_IMAGE=ollama/ollama:0.17.7
QDRANT_IMAGE=qdrant/qdrant:v1.13.2
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable   # rolling (main-stable)
N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.77.0
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest               # rolling
NODE_BUILD_IMAGE=node:22-alpine
NGINX_RUNTIME_IMAGE=nginx:alpine
PYTHON_BASE_IMAGE=python:3.12-slim
