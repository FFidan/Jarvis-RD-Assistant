# versions.env — tested image versions for JARVIS RD Assistant
# This file pins third-party Docker images to known-good versions.
# Maintainers bump these after testing upgrades; users pull updates via:
#   git pull && ./update.sh
#
# Pinning rule: an image the project builds FROM carries its digest alongside
# its tag (tag@sha256:...), because a republished tag would silently change what
# a released image contains. An image the project only runs carries its version
# tag alone. Read a new digest out of the registry rather than writing one by
# hand — `docker buildx imagetools inspect <image>:<tag>` prints the index
# digest that covers every architecture.
#

POSTGRES_IMAGE=postgres:16.8@sha256:301bcb60b8a3ee4ab7e147932723e3abd1cef53516ce5210b39fd9fe5e3602ae
# Langfuse's bundled Postgres uses the alpine flavour; kept separate from
# POSTGRES_IMAGE so the main DB and the observability DB can pin independently.
LANGFUSE_POSTGRES_IMAGE=postgres:16.8-alpine
OLLAMA_IMAGE=ollama/ollama:0.31.2
# ROCm flavour of the SAME Ollama version, used by docker-compose.rocm.yml on AMD
# hosts (the overlay reads ${OLLAMA_ROCM_IMAGE}). Keep the version in lockstep
# with OLLAMA_IMAGE so `git pull && ./update.sh` moves both together.
OLLAMA_ROCM_IMAGE=ollama/ollama:0.31.2-rocm
QDRANT_IMAGE=qdrant/qdrant:v1.13.2
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm@sha256:29252f25ed1b538d44f6b76ec97412c5537a180b39ede744b9f3e86ffdd278f5
LANGFUSE_IMAGE=langfuse/langfuse@sha256:85c278dcab96c15db94191a5c1664f85aba2d7fb6771a00e99681c902c4b7015
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2025.1.0
NODE_BUILD_IMAGE=node:22.22.2-alpine3.23@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f
NGINX_RUNTIME_IMAGE=nginxinc/nginx-unprivileged:1.31-alpine3.24@sha256:334d92979f15aaecd5dd50af5105e1230e2bb70765d45b1e2f964e7c5eda81c3
# Base image for every Python service image. The digest is what a published
# release builds from; the Dockerfile ARG defaults repeat the bare tag so a
# developer build that never reads this file still works.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm@sha256:32e2c347413bae52d567e2cc3eef31cd617a83dcac51644caadc0bbac131395a
CADDY_IMAGE=caddy:2.9-alpine
VECTOR_IMAGE=timberio/vector:0.40.0-alpine
