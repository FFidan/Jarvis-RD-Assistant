# Node
node_modules/
**/node_modules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
**/.venv
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Environment and secrets - NEVER commit
.env
.env.local
.env.*.local
.env.production
.env.pre-setup.bak
.jarvis-setup-transaction
.jarvis-setup-transaction.pending
.env.pre-config-key-rotation.bak
.env.rotation.*
# Catch-all for every other machine-local .env variant. The named rules above and
# below cover the shapes this project's own scripts create; this one covers the
# rest, including the dated copies people make by hand before upgrading. One such
# file was found untracked and unignored in a working tree, matching no rule --
# and a file holding every deployment secret should never be one `git add -A`
# away from being published. The un-ignore keeps the committed `.env.example`
# files visible at every depth.
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json

# Docker Secrets — plain-text credential files
secrets/*.txt
secrets/*.rotation
secrets/.jarvis_config_key_rotation.lock

# Machine-local lifecycle state and interrupted-write residue. These are created by
# setup, update, backup, restore and key rotation; none is ever committed, and an
# orphaned one must not be able to block a future update. The six-character form
# matches the `mktemp .env.XXXXXX` template and leaves `.env.example` visible.
secrets/manifest-hmac-required
secrets/*.txt.restore.*
secrets/jarvis_config_key_rotation_state.txt.*
.env.restore.*
/.env.??????
secrets/.platform-identity-private.??????
secrets/.platform-identity-public.??????
litellm/.config.yaml.*

# Docker local overrides
docker-compose.override.yml

# Personal / per-machine setup notes (maintainer only)
PERSONAL-SETUP.md
docs/personal/

# Local PII-guard overrides (per-machine personal patterns / allowlist)
scripts/pii-patterns-local.sh
scripts/pii-allowlist-local.txt

# Generated data (large, user-specific)
shared/pdf_storage/
shared/local_pdfs/
shared/snapshots/
shared/perf/

