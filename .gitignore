.ruff_cache/
# JUnit reports written into the repo root by the release gates and CI test jobs
# (baseline-invariants, contract-tests, corpus-visibility-qdrant, cross-user-isolation).
*.junit.xml

# Jupyter
.ipynb_checkpoints/

# Raw pdfs and images
*.pdf
*.png
# Exception: PWA app icons must be committed (required for Android-Chrome install / maskable)
!frontend/public/icons/*.png
# Exception: README / docs-site product screenshots must be committed (else they 404 on the public repo)
!docs/screenshots/*.png

# Test artifacts
**/test-results/

# Perf profile snapshots (reproducible via `make profile`)
artifacts/

# MkDocs build output (generated; deploy target is gh-pages branch)
site/
Jarvis_RD.zip

*.tar.gz

# Local worktrees
.worktrees/
