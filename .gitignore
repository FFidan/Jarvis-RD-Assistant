# Node
node_modules/
**/node_modules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
**/.venv
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Environment and secrets - NEVER commit
.env
.env.local
.env.*.local
.env.production
.env.pre-setup.bak
*.pem
*.key
*.p12
credentials.json

# Docker Secrets — plain-text credential files
secrets/*.txt

# Docker local overrides
docker-compose.override.yml

# Personal / per-machine setup notes (maintainer only)
PERSONAL-SETUP.md
docs/personal/

# Local PII-guard overrides (per-machine personal patterns / allowlist)
scripts/pii-patterns-local.sh
scripts/pii-allowlist-local.txt

# Generated data (large, user-specific)
shared/pdf_storage/
shared/snapshots/
shared/perf/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
/logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Raw pdfs and images
*.pdf
*.png
# Exception: PWA app icons must be committed (required for Android-Chrome install / maskable)
!frontend/public/icons/*.png
# Exception: README / docs-site product screenshots must be committed (else they 404 on the public repo)
!docs/screenshots/*.png

# Test artifacts
**/test-results/

# Perf profile snapshots (reproducible via `make profile`)
artifacts/

# MkDocs build output (generated; deploy target is gh-pages branch)
site/
Jarvis_RD.zip

*.tar.gz

# Local worktrees
.worktrees/
