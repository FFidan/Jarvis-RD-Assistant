# ==================================================================
# WARNING: You MUST set all required values before running in production.
# Services will refuse to start if required values are left empty.
# Copy this file to .env and edit: cp .env.example .env
# ==================================================================

# =============================================================================
# JARVIS RD Assistant - Configuration
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# At minimum you need: POSTGRES_PASSWORD, N8N_ENCRYPTION_KEY,
# JARVIS_API_KEY, and optionally TELEGRAM_BOT_TOKEN for the Telegram bot.
#
# Recommended: run ./setup.sh instead of editing this file by hand — it
# generates all secrets, asks 2 questions, and starts the stack.
#
# Image versions (postgres, qdrant, ollama, litellm, cloudflared, n8n, nginx)
# are pinned in versions.env and consumed by docker-compose.yml via
# ${VAR:-fallback} substitution. Do NOT put image tags here — source
# versions.env before `docker compose up` if you want non-fallback pins,
# or let update.sh manage them for you.
# =============================================================================

# === REQUIRED: Database ===
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=

# === REQUIRED: n8n ===
N8N_ENCRYPTION_KEY=
N8N_JWT_SECRET=

# =============================================================
# PRODUCTION SECURITY — change these before deployment!
# Generate a strong key:  openssl rand -hex 32
# DEV_MODE=true only skips auth when JARVIS_API_KEY is unset.
# Even in DEV_MODE, a configured API key is ALWAYS enforced.
# =============================================================

# === REQUIRED: API Authentication ===
# This key authenticates ALL API requests (dashboard, Telegram, scripts).
# Generate with: openssl rand -hex 32
# The dashboard login page prompts for this key.
JARVIS_API_KEY=

# === REQUIRED: Secret encryption key ===
# 32-byte Fernet key for at-rest secret encryption (Zotero/LLM provider API keys).
# setup.sh auto-generates one; manually: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_CONFIG_KEY=

# Development mode — only bypasses auth when JARVIS_API_KEY is *not set*.
# If a key is configured, DEV_MODE has no effect on authentication.
DEV_MODE=false

# ENVIRONMENT safety guard — set to "production" for production deployments.
# Prevents DEV_MODE=true from accidentally running in production.
ENVIRONMENT=development

# === OPTIONAL: Telegram (opt-in via `docker compose --profile telegram up -d`) ===
# Create a bot via @BotFather on Telegram to get the token.
# TELEGRAM_CHAT_ID is no longer required — use the dashboard's pairing flow instead.
# The telegram_bot container will refuse to start without a real token (not a placeholder).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === REQUIRED: LiteLLM Admin Key ===
# Gates all LiteLLM admin endpoints (/config/update, /model/*, etc.).
# Generate with: openssl rand -hex 32
# All JARVIS services read this via build_litellm_headers(); loopback
# binding (127.0.0.1:4000) provides defence-in-depth when unset.
LITELLM_MASTER_KEY=

# === LLM PROVIDERS (at least one, or use Ollama which needs no key) ===
# Leave blank to skip a provider. LiteLLM will fall back to Ollama if no
# cloud provider keys are set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === OPTIONAL: Ollama ===
# Models to pull on first start (comma-separated).
# These are used as fallback when no cloud API keys are configured.
OLLAMA_MODELS=mistral-nemo,qwen3:4b,nomic-embed-text

# OLLAMA_MAX_LOADED_MODELS — keep this many Ollama models hot in VRAM.
# On a 16 GB GPU shared with Marker (PDF text extraction), 3 may exhaust VRAM
# and surface as "PDF text-extraction GPU out-of-memory" errors during paper
# processing. Drop to 2 if you see those errors. Set TORCH_DEVICE=cpu on the
# paper_ingestion service as an alternative.
OLLAMA_MAX_LOADED_MODELS=3

# === OPTIONAL: Embedding ===
# Dimension must match the embedding model configured in litellm/config.yaml.
#   nomic-embed-text (Ollama, default):      768
#   OpenAI text-embedding-3-small:           768 (supports up to 1536)
EMBEDDING_MODEL=embed
EMBEDDING_DIMENSION=768

# Qdrant vector DB authentication (leave empty for dev mode / no auth)
QDRANT_API_KEY=

# === OPTIONAL: Paper Ingestion ===
# Interval (hours) between automatic paper fetch cycles (default: 6)
AUTO_FETCH_INTERVAL_HOURS=6

# Cross-encoder reranker (optional; adds ~2 GB PyTorch dep)
# To enable: set RERANKER_ENABLED=true AND rebuild with INSTALL_OPTIONAL=true
#   INSTALL_OPTIONAL=true docker compose build paper_ingestion
# Disabled by default to keep the image lean.
RERANKER_ENABLED=false

# === OPTIONAL: Host Port Overrides ===
# Defaults avoid overlap with JARVIS_BUSINESS_Assistant on localhost.
DASHBOARD_HOST_PORT=3001
PAPER_INGESTION_HOST_PORT=8010
LEARNING_ENGINE_HOST_PORT=8011

# === OPTIONAL: Dashboard bind address ===
# 127.0.0.1 = localhost-only (default, safest).
# 0.0.0.0   = all interfaces (LAN mode; set automatically by setup.sh).
DASHBOARD_BIND_HOST=127.0.0.1

# === OPTIONAL: Database Backup ===
# Enable with: docker compose --profile backup up -d
# S3 upload requires awscli in the backup sidecar — see scripts/backup.sh for setup.
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_INTERVAL_SECONDS=86400

# === OPTIONAL: Connection Pool Tuning ===
DB_POOL_MIN=2
DB_POOL_MAX=10

# === OPTIONAL: Logging ===
# Set log level for all services (default: INFO)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === OPTIONAL: CORS ===
# Comma-separated allowed origins. Must match your dashboard URL.
# Dashboard uses HTTPS with self-signed certs by default.
CORS_ORIGINS=https://localhost:3001

# === OPTIONAL: Rate limiter — trusted proxy CIDRs ===
# Comma-separated CIDRs whose IPs are skipped when walking X-Forwarded-For
# right-to-left to find the real client IP (rightmost-trusted hop extraction).
# RFC-1918 ranges and 127.0.0.0/8 are always trusted by default.
# Add your load-balancer or reverse-proxy CIDRs here if needed.
TRUSTED_PROXY_CIDRS=

# Set to true if running behind Cloudflare (uses CF-Connecting-IP header for rate limiting).
# When enabled, the CF-Connecting-IP header is preferred over X-Forwarded-For parsing.
# Default: false (only trust X-Forwarded-For + rightmost-trusted hop extraction).
JARVIS_TRUST_CF_CONNECTING_IP=false

# === OPTIONAL: TLS Certificate SAN (Subject Alternative Name) ===
# Controls which hostnames/IPs the self-signed cert is valid for.
# Set automatically by setup.sh based on access mode. Override manually
# only if you know what you're doing.
#   localhost:  DNS:localhost,IP:127.0.0.1
#   LAN:        DNS:localhost,IP:127.0.0.1,IP:<LAN_IP>
#   tunnel:     DNS:localhost,IP:127.0.0.1,DNS:<TUNNEL_HOSTNAME>
JARVIS_CERT_SAN=DNS:localhost,IP:127.0.0.1

# Skip frontend self-signed cert auto-generation on startup (set to true when providing your own certs or using Let's Encrypt).
JARVIS_SKIP_SELFSIGNED_GEN=false

# =====================================================================
# OPTIONAL: Public HTTPS with Let's Encrypt (Caddy sidecar)
# Activate with: docker compose --profile letsencrypt up -d caddy
# Caddy terminates public TLS and proxies to the dashboard's internal
# HTTPS listener. Keep JARVIS_SKIP_SELFSIGNED_GEN=false unless you mount
# real dashboard certs, because nginx still needs its internal cert files.
# =====================================================================
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=
LETSENCRYPT_HTTP_PORT=80
LETSENCRYPT_HTTPS_PORT=443

# =====================================================================
# OPTIONAL: Global Access (Cloudflare Tunnel)
# Obtain a token from dash.cloudflare.com → Zero Trust → Networks → Tunnels.
# The tunnel connects outbound-only; no ports need to be exposed.
# Activate with: docker compose --profile tunnel up -d
# =====================================================================
CLOUDFLARE_TUNNEL_TOKEN=

# Set to 1 ONLY after you have configured Cloudflare Zero-Trust access policies
# at https://one.dash.cloudflare.com/. Without proper ZT access, your services
# are exposed publicly on the internet.
JARVIS_TUNNEL_ACK_ZT_CONFIGURED=

# === OPTIONAL: Tunnel public hostname ===
# Set automatically by setup.sh when choosing global (tunnel) mode.
# Must match the hostname configured in Cloudflare Zero Trust → Tunnels.
TUNNEL_HOSTNAME=

# === OPTIONAL: Telegram Bot Internal URL ===
# URL for telegram_bot internal API; set empty to skip nudge reload when telegram profile is off
TELEGRAM_BOT_URL=http://telegram_bot:8002

# === OPTIONAL: Langfuse observability (requires --profile observability) ===
# Connect to your Langfuse instance to trace LLM calls.
# Start Langfuse: docker compose --profile observability up -d
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST_PORT=3002
LANGFUSE_NEXTAUTH_SECRET=changeme_nextauth_secret
LANGFUSE_SALT=changeme_salt_32chars_minimum_len
LANGFUSE_PG_PASSWORD=langfuse_dev_password
