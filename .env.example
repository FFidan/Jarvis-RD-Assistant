# ==================================================================
# WARNING: You MUST set all required values before running in production.
# Services will refuse to start if required values are left empty.
# Copy this file to .env and edit: cp .env.example .env
# ==================================================================

# =============================================================================
# JARVIS RD Assistant - Configuration
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# At minimum you need: POSTGRES_PASSWORD and JARVIS_API_KEY, and optionally
# TELEGRAM_BOT_TOKEN for the Telegram bot.
#
# Recommended: run ./setup.sh instead of editing this file by hand — it
# generates all secrets, asks 2 questions, and starts the stack.
#
# Image versions (postgres, qdrant, ollama, litellm, cloudflared, nginx)
# are pinned in versions.env and consumed by docker-compose.yml via
# ${VAR:-fallback} substitution. Do NOT put image tags here — source
# versions.env before `docker compose up` if you want non-fallback pins,
# or let update.sh manage them for you.
# =============================================================================

# === REQUIRED: Database ===
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=

# =============================================================
# PRODUCTION SECURITY — change these before deployment!
# Generate a strong key:  openssl rand -hex 32
# DEV_MODE=true only skips auth when JARVIS_API_KEY is unset.
# Even in DEV_MODE, a configured API key is ALWAYS enforced.
# =============================================================

# === OPTIONAL: SMTP relay (magic-link delivery) ===
# Configured via the first-run web wizard (recommended) — these vars exist for
# operators who prefer env-var deployment. When unset OR DEV_MODE=true, magic
# links are logged to stdout instead of emailed.
#   Recommended free relay: Resend (https://resend.com) — 3000/mo free tier.
#     SMTP_HOST=smtp.resend.com
#     SMTP_PORT=465              # 465 = implicit TLS, 587 = STARTTLS
#     SMTP_USER=resend
#     SMTP_PASS=<resend-api-key>
#     SMTP_FROM=jarvis@your-verified-domain.dev
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set true ONLY if SMTP_HOST is a legitimate internal relay on a private address.
# When false (default), a private/loopback/reserved SMTP host is rejected (SSRF guard).
ALLOW_PRIVATE_SMTP_HOST=false

# === REQUIRED: API Authentication ===
# This key authenticates ALL API requests (dashboard, Telegram, scripts).
# Generate with: openssl rand -hex 32
# The dashboard login page prompts for this key.
JARVIS_API_KEY=

# === Install mode (written by setup.sh; do not hand-edit) ===
# single = personal instance: log in with JARVIS_API_KEY via the
#          api-key-session endpoint, SMTP optional. multi = team:
#          email/magic-link login, SMTP required.
JARVIS_SETUP_MODE=single
# When true, POST /api/auth/api-key-session may mint an owner session.
# Still single-tenant-gated server-side (auth.py) — NOT an auth bypass.
API_KEY_LOGIN_ENABLED=true

# === REQUIRED: Secret encryption key ===
# 32-byte Fernet key for at-rest secret encryption (Zotero/LLM provider API keys).
# setup.sh auto-generates one; manually: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JARVIS_CONFIG_KEY=

# === REQUIRED in production: Pulse model HMAC signing key ===
# Dedicated key that HMAC-signs the Pulse classifier pickle blobs stored in the
# pulse_models table. Audit H14 removed the public-literal fallback because an
# attacker with DB write access could otherwise forge a signed blob and trigger
# RCE via pickle.loads. Mandatory in production (ENVIRONMENT=production) — the
# services refuse to start without it and there is NO derivation fallback there.
# (Outside production a JARVIS_API_KEY-derived key is used for convenience.)
# Auto-generated by scripts/init-secrets.sh (which setup.sh / jarvis-setup.sh
# invoke) — leave this BLANK and do NOT hand-edit; a blank value is the
# absent-trigger that makes the generator mint a fresh 64-hex key.
# See docs/SECURITY.md#pulse-model-signing.
JARVIS_MODEL_HMAC_KEY=

# Development mode meta-flag.  When DEV_MODE=true, any granular dev flag below
# that is NOT explicitly set in the environment is promoted to true, preserving
# the v0.3 "all unlocked" dev UX.  An explicit individual flag always wins.
# If a JARVIS_API_KEY is configured, authentication is enforced even in DEV_MODE.
# Never set DEV_MODE=true in ENVIRONMENT=production (startup check enforces this).
DEV_MODE=false

# Granular dev flags — each can be set independently of DEV_MODE.
# All five are refused in ENVIRONMENT=production (startup will crash).
#
# DEV_AUTH_BYPASS=false    # Skip API-key auth when JARVIS_API_KEY is unset
# DEV_ERROR_DETAIL=false   # Return pydantic field-level errors in 422 responses
# DEV_CORS_OPEN=false      # Set CORS allow_origins=["*"] (overrides CORS_ORIGINS)
# DEV_SMTP_LOG_ONLY=false  # Log magic-link URLs instead of sending real email
# DEV_CRYPTO_RELAXED=false # Warn (not crash) when encrypted config rows fail decryption

# Enable test-only job kinds (e.g. noop.test). Set to "1" in CI/dev only.
# Must be "0" (or unset) in production.
JARVIS_ENABLE_TEST_JOBS=0

# ENVIRONMENT safety guard — set to "production" for production deployments.
# Prevents DEV_MODE=true from accidentally running in production.
ENVIRONMENT=development

# === OPTIONAL: Telegram (opt-in via `docker compose --profile telegram up -d`) ===
# Create a bot via @BotFather on Telegram to get the token.
# The telegram_bot container will refuse to start without a real token (not a placeholder).
TELEGRAM_BOT_TOKEN=

# === REQUIRED: LiteLLM Admin Key ===
# Gates all LiteLLM admin endpoints (/config/update, /model/*, etc.).
# Generate with: openssl rand -hex 32
# All JARVIS services read this via build_litellm_headers(); loopback
# binding (127.0.0.1:4000) provides defence-in-depth when unset.
LITELLM_MASTER_KEY=

# === LLM PROVIDERS (at least one, or use Ollama which needs no key) ===
# Leave blank to skip a provider. LiteLLM will fall back to Ollama if no
# cloud provider keys are set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === OPTIONAL: Ollama ===
# Models to pull on first start (comma-separated).
# These are used as fallback when no cloud API keys are configured.
#
# Default is sized for a single ~16 GB GPU that must keep the embedding model
# (qwen3-embedding:4b) GPU-resident while ALSO running chat + Docling PDF
# extraction. qwen3:8b is the "smart" role; qwen3:4b the "fast" role.
# VRAM guidance (chat model in the smart role; embedder always qwen3-embedding:4b):
#   ~12 GB : qwen3:4b,qwen3-embedding:4b      (set smart=fast in the app)
#   ~16 GB : qwen3:8b,qwen3:4b,qwen3-embedding:4b   (default)
#   ~24 GB+: qwen3:14b,qwen3:8b,qwen3:4b,qwen3-embedding:4b
# Switch the smart role at runtime via the in-app model picker
# (Settings → llm.smart_model) — no redeploy needed.
OLLAMA_MODELS=qwen3:8b,qwen3:4b,qwen3-embedding:4b

# OLLAMA_MAX_LOADED_MODELS — keep this many Ollama models hot in VRAM.
# On a 16 GB GPU shared with Docling (PDF text extraction), 3 may exhaust VRAM
# and surface as "PDF text-extraction GPU out-of-memory" errors during paper
# processing. Drop to 2 if you see those errors. Set TORCH_DEVICE=cpu on the
# paper_ingestion service as an alternative.
OLLAMA_MAX_LOADED_MODELS=3

# === OPTIONAL: Pulse LLM scoring ===
# Stage-2 Pulse scoring uses the fast local alias by default so manual
# regeneration does not monopolize the larger smart model. Override only when
# you deliberately want higher latency/higher quality scoring.
PULSE_STAGE2_MODEL=fast
PULSE_STAGE2_MAX_RETRIES=1

# === OPTIONAL: Embedding ===
# Dimension must match the embedding model configured in litellm/config.yaml.
#   qwen3-embedding:4b   (Ollama, default): 2560
#   qwen3-embedding:0.6b (Ollama fallback): 1024
#   nomic-embed-text (legacy Ollama):       768
#   OpenAI text-embedding-3-small:           768 (supports up to 1536)
EMBEDDING_MODEL=embed
EMBEDDING_MODEL_NAME=qwen3-embedding:4b
EMBEDDING_DIMENSION=2560

# Read timeout (seconds) for one LiteLLM /v1/embeddings call. Default 300
# tolerates the embedder being GPU-evicted to CPU on memory-bound machines,
# where a 32-chunk batch can take minutes. Lower only on fast dedicated
# embedding hardware.
EMBED_REQUEST_TIMEOUT_SECONDS=300

# Qdrant vector DB authentication (leave empty for dev mode / no auth)
QDRANT_API_KEY=

# === OPTIONAL: Paper Ingestion ===
# Interval (hours) between automatic paper fetch cycles (default: 6)
AUTO_FETCH_INTERVAL_HOURS=6

# Cross-encoder reranker (optional; adds ~2 GB PyTorch dep)
# To enable: set RERANKER_ENABLED=true AND rebuild with INSTALL_OPTIONAL=true
#   INSTALL_OPTIONAL=true docker compose build paper_ingestion
# Disabled by default to keep the image lean.
RERANKER_ENABLED=false

# === OPTIONAL: Reranker backend selection ===
# RERANKER_BACKEND=cross-encoder  # Alternative backend: cross-encoder or qwen3
# QWEN3_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B  # HuggingFace model ID for Qwen3 reranker
# QWEN3_RERANKER_REVISION=main  # Git revision/tag for Qwen3 model checkpoint

# === OPTIONAL: Pulse (decked follow-up suggestion) scoring ===
# PULSE_STAGE2_TIMEOUT_SECONDS=900  # Wall-clock timeout for Stage-2 LLM ranking (seconds)
# PULSE_LLM_CONCURRENCY=4  # Max concurrent LLM calls during Stage-2 scoring

# === OPTIONAL: External metadata APIs (paper discovery) ===
# SEMANTIC_SCHOLAR_API_KEY=  # Semantic Scholar API key
# PUBMED_API_KEY=  # NCBI/PubMed API key
# OPENALEX_API_KEY=  # OpenAlex API key
# OPENALEX_EMAIL=  # Email for OpenAlex polite-pool access
# NCBI_TOOL=JARVIS-RD  # Tool name for NCBI E-utilities
# NCBI_EMAIL=  # Contact email for NCBI E-utilities

# === OPTIONAL: HTTP source cache (metadata fetches) ===
# SOURCE_HTTP_CACHE_ENABLED=true  # Cache GET/200 from arXiv, S2, OpenAlex, NCBI (default: true)
# SOURCE_HTTP_CACHE_TTL_SECONDS=900  # Cache time-to-live in seconds (default: 900)

# === OPTIONAL: Rate limiting ===
# GLOBAL_RATE_LIMIT=600/minute  # Global API rate limit
# ASK_RATE_LIMIT=10/minute  # Per-user RAG ask endpoint rate limit

# === OPTIONAL: PDF extraction and processing ===
# DOCLING_ARTIFACTS_PATH=  # Local path to prefetched Docling models (offline/air-gapped deploys)

# === OPTIONAL: Zotero Better BibTeX integration ===
# BBT_BASE_URL=http://host.docker.internal:23119  # Better BibTeX server base URL
# APP_BASE_URL=  # Public-facing app URL (for magic-link emails and invite links)
# JARVIS_BASE_URL=https://jarvis.example.com  # absolute base for Telegram digest links

# === OPTIONAL: Advanced infrastructure ===
# JARVIS_MIGRATION_LOCK_CONTENDED_OK=false  # Allow advisory-lock contention in multi-replica deploys
# INFRA_INGEST_KEY=  # Secret key for /api/infra-events endpoint
# INFRA_INGEST_KEY_FILE=  # Path to file containing infra-ingest key (Docker Secret)
# INFRA_INGEST_ALLOWED_CIDRS=  # Comma-separated CIDRs allowed to POST to /api/infra-events

# === OPTIONAL: Runtime settings ===
# Note: automation.fetch_interval_hours can also be set at runtime via the dashboard
# (Settings → automation.fetch_interval_hours) without redeployment.

# === OPTIONAL: Host Port Overrides ===
# Defaults avoid overlap with other local services.
DASHBOARD_HOST_PORT=3001
PAPER_INGESTION_HOST_PORT=8010
LEARNING_ENGINE_HOST_PORT=8011

# === OPTIONAL: Dashboard bind address ===
# 127.0.0.1 = localhost-only (default, safest).
# 0.0.0.0   = all interfaces (LAN mode; set automatically by setup.sh).
DASHBOARD_BIND_HOST=127.0.0.1

# === OPTIONAL: Dashboard accepted Host header(s) ===
# The dashboard nginx rejects (444) requests whose Host isn't in its allowlist
# (localhost/127.0.0.1 by default; Caddy profiles rewrite Host->localhost). For
# DIRECT remote access without Caddy (e.g. `tailscale serve` or a LAN hostname),
# add that hostname here, else nginx returns 444 and the proxy shows 502.
# Example: DASHBOARD_SERVER_NAME=my-host.tailnet-name.ts.net
DASHBOARD_SERVER_NAME=

# === OPTIONAL: Database Backup ===
# Enable with: docker compose --profile backup up -d
# S3 upload requires awscli in the backup sidecar — see scripts/backup.sh for setup.
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_INTERVAL_SECONDS=86400
# Path to the encryption passphrase file used by backup.sh.
# When set and the file is non-empty, pg_dump output is encrypted with
# AES-256-CBC (PBKDF2, 600 000 iterations) and saved as .sql.gz.enc.
# The postgres-backup service mounts this as a Docker Secret; the value
# here is the path inside the container (/run/secrets/backup_encrypt_key).
# init-secrets.sh auto-generates the key file at secrets/backup_encrypt_key.txt.
BACKUP_ENCRYPT_KEYFILE=/run/secrets/backup_encrypt_key

# === OPTIONAL: Connection Pool Tuning ===
DB_POOL_MIN=2
DB_POOL_MAX=10

# === OPTIONAL: Logging ===
# Set log level for all services (default: INFO)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === OPTIONAL: CORS ===
# Comma-separated allowed origins. Must match your dashboard URL *including scheme*.
# Direct dashboard access (non-Caddy) uses plain HTTP on port 3001 (default below).
# If you enable the Caddy HTTPS profile, change this to https://localhost:3001
# (or your domain) — a scheme mismatch silently fails cross-origin requests.
CORS_ORIGINS=http://localhost:3001

# === OPTIONAL: Rate limiter — trusted proxy CIDRs ===
# Comma-separated CIDRs whose IPs are skipped when walking X-Forwarded-For
# right-to-left to find the real client IP (rightmost-trusted hop extraction).
# RFC-1918 ranges and 127.0.0.0/8 are always trusted by default.
# Add your load-balancer or reverse-proxy CIDRs here if needed.
# Note: nginx real_ip trust is automatic via pinned Docker IPs (Caddy /32).
# See docs/DEPLOYMENT.md.
TRUSTED_PROXY_CIDRS=

# === OPTIONAL: Internal Docker network subnet ===
# The jarvis Docker network is pinned to this /24 so nginx can trust exactly
# the Caddy TLS terminator's static IP. Leave unset (default 10.137.241.0/24)
# unless this CIDR conflicts with an existing host LAN segment. setup.sh --check
# warns on a collision. When overriding, also run: docker compose down && docker compose up -d
#
# WARNING: overriding JARVIS_NET_SUBNET requires updating one hard-coded literal:
#   frontend/nginx.conf — 'set_real_ip_from 10.137.241.2/32' and
#   'set_real_ip_from 10.137.241.3/32' must be updated to the new Caddy IPs,
#   or all clients collapse to one rate-limit bucket (self-DoS regression).
# Note: docker-compose.yml no longer has a hardcoded gateway; Docker auto-assigns
# the first host in JARVIS_NET_SUBNET so 'docker compose up' will not hard-fail.
# setup.sh --check will warn when this variable is set to a non-default value.
# JARVIS_NET_SUBNET=10.137.241.0/24

# Set to true if running behind Cloudflare (uses CF-Connecting-IP header for rate limiting).
# When enabled, the CF-Connecting-IP header is preferred over X-Forwarded-For parsing.
# Default: false (only trust X-Forwarded-For + rightmost-trusted hop extraction).
JARVIS_TRUST_CF_CONNECTING_IP=false

# === OPTIONAL: TLS Certificate SAN (Subject Alternative Name) ===
# Controls which hostnames/IPs the self-signed cert is valid for.
# Set automatically by setup.sh based on access mode. Override manually
# only if you know what you're doing.
#   localhost:  DNS:localhost,IP:127.0.0.1
#   LAN:        DNS:localhost,IP:127.0.0.1,IP:<LAN_IP>
#   tunnel:     DNS:localhost,IP:127.0.0.1,DNS:<TUNNEL_HOSTNAME>
JARVIS_CERT_SAN=DNS:localhost,IP:127.0.0.1

# Skip frontend self-signed cert auto-generation on startup.
# Default true: the dashboard serves plain HTTP internally and TLS is
# terminated by the Caddy profile, while the ./certs mount is read-only — so a
# false value makes the in-container generate-certs.sh fail writing to it. Keep
# true unless you have configured the nginx layer for direct TLS with your own
# certs and a writable certs mount.
JARVIS_SKIP_SELFSIGNED_GEN=true

# =====================================================================
# OPTIONAL: Public HTTPS with Let's Encrypt (Caddy sidecar)
# Activate with: docker compose --profile letsencrypt up -d caddy
# Caddy terminates public TLS and proxies to the dashboard over plain HTTP,
# so the default JARVIS_SKIP_SELFSIGNED_GEN=true is correct here. Set it to
# false only if you switch nginx to direct TLS with your own writable certs.
# =====================================================================
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=
LETSENCRYPT_HTTP_PORT=80
LETSENCRYPT_HTTPS_PORT=443

# =====================================================================
# OPTIONAL: Global Access (Cloudflare Tunnel)
# Obtain a token from dash.cloudflare.com → Zero Trust → Networks → Tunnels.
# The tunnel connects outbound-only; no ports need to be exposed.
# Activate with: docker compose --profile tunnel up -d
# =====================================================================
CLOUDFLARE_TUNNEL_TOKEN=

# Set to 1 ONLY after you have configured Cloudflare Zero-Trust access policies
# at https://one.dash.cloudflare.com/. Without proper ZT access, your services
# are exposed publicly on the internet.
JARVIS_TUNNEL_ACK_ZT_CONFIGURED=

# === OPTIONAL: Tunnel public hostname ===
# Set automatically by setup.sh when choosing global (tunnel) mode.
# Must match the hostname configured in Cloudflare Zero Trust → Tunnels.
TUNNEL_HOSTNAME=

# === OPTIONAL: Telegram Bot Internal URL ===
# URL for telegram_bot internal API; set empty to skip nudge reload when telegram profile is off
TELEGRAM_BOT_URL=http://telegram_bot:8002

# === OPTIONAL: Langfuse observability (requires --profile observability) ===
# Connect to your Langfuse instance to trace LLM calls.
# Start Langfuse: docker compose --profile observability up -d
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY are file-only — do NOT set them here.
# The operator project keypair lives solely in secrets/langfuse_init_pk.txt /
# secrets/langfuse_init_sk.txt (generated by scripts/gen-langfuse-keys.sh) and is
# injected via LANGFUSE_PUBLIC_KEY_FILE / LANGFUSE_SECRET_KEY_FILE. See docs/contracts/04-observability.md §9.
LANGFUSE_HOST_PORT=3002
# The following three values are AUTO-GENERATED by ``scripts/init-secrets.sh``
# (which appends them to .env on first run and mirrors copies into ./secrets/).
# Compose fail-fasts when any of them is unset under --profile observability,
# so do not commit weak placeholders here.
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_PG_PASSWORD=
#
# Set OBSERVABILITY_ENABLED=true to enable Langfuse tracing in JARVIS services.
# LANGFUSE_INIT_USER_EMAIL and _USER_PASSWORD provision the operator account on
# first boot (headless). pk/sk live ONLY in secrets/langfuse_init_*.txt — never here.
OBSERVABILITY_ENABLED=false
# Set to http://langfuse:3000 to enable trace export (see docs/contracts/04-observability.md §9)
LANGFUSE_HOST=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# === Hardware-aware LLM backend (written by setup.sh) ===
# Detected at install; re-probed at every container boot. Do not hand-edit.
JARVIS_HW_TIER=cpu
# Backend serving the LiteLLM `smart` alias. ollama is the safe default.
JARVIS_LLM_BACKEND=ollama
# Model id for the active backend (Ollama tag or HuggingFace AWQ repo).
JARVIS_SMART_MODEL=qwen3:8b
# Set automatically by setup.sh based on JARVIS_LLM_BACKEND. Do not hand-edit.
COMPOSE_PROFILES=
# Written by setup.sh so a bare `docker compose up` engages the same overlays
# (GPU). Leave unset on pure-CPU hosts. Do not hand-edit.
# COMPOSE_FILE=

# === OPTIONAL: X-Owner-User-Id override allowlist (SEC-OWNER-2) ===
# Comma-separated CIDRs trusted to send the X-Owner-User-Id header.
# The Telegram bot uses this to perform per-user API calls on behalf of paired users.
# WARNING: every container whose source IP falls within a listed subnet can forge
#          per-user identity (impersonate any user_id in the database).
# Use the tightest /32 entries possible in production (e.g. 10.137.241.5/32).
# The compose stack sets this automatically to loopback + the jarvis bridge
# subnet (tracks JARVIS_NET_SUBNET, default 10.137.241.0/24) so the bot is
# trusted out of the box. Only set this explicitly to tighten it (e.g. a /32),
# or if the bot reaches the services from some other network.
# OWNER_OVERRIDE_ALLOWED_CIDRS=127.0.0.0/8,10.137.241.0/24
