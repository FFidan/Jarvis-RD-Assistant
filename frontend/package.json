{
  "name": "jarvis-frontend",
  "private": true,
  "version": "1.2.4",
  "author": "Ferhat Fidan <jarvis-rd@limitcycle.dev>",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test",
    "test:e2e:mocked": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test e2e/citation-graph.spec.ts e2e/knowledge-graph.spec.ts e2e/feed-lifecycle.spec.ts e2e/feedback-loop.spec.ts e2e/feed/feed-ia-v3.spec.ts e2e/paper-detail-3pane.spec.ts e2e/my-day-redesign.spec.ts e2e/analytics-mocked.spec.ts e2e/projects-ia-mocked.spec.ts e2e/settings-ia.spec.ts e2e/settings-provider-routing.spec.ts e2e/learning-cards-ia.spec.ts e2e/shell-admin-ask.spec.ts",
    "test:e2e:live-smoke": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test --grep @live-smoke",
    "test:e2e:live-readonly": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test e2e/auth.spec.ts e2e/home.spec.ts e2e/navigation.spec.ts e2e/analytics.spec.ts e2e/learning-cards.spec.ts e2e/extractions.spec.ts",
    "test:e2e:live-mutating": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test e2e/feed/discovery.spec.ts e2e/projects.spec.ts e2e/settings/authors.spec.ts e2e/settings/automation.spec.ts e2e/settings/ingestion.spec.ts e2e/settings/sources.spec.ts e2e/settings/templates.spec.ts e2e/settings/topics.spec.ts",
    "test:e2e:cross-user": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test --grep @cross-user",
    "screenshots:generate": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test --config=playwright.screenshots.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 474"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
