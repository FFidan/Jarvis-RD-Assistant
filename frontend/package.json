{
  "name": "jarvis-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test",
    "test:e2e:mocked": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test e2e/feed/library.spec.ts e2e/paper-detail.spec.ts e2e/citation-graph.spec.ts e2e/knowledge-graph.spec.ts",
    "test:e2e:live-smoke": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test --grep @live-smoke",
    "test:e2e:live-readonly": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test e2e/auth.spec.ts e2e/home.spec.ts e2e/navigation.spec.ts e2e/analytics.spec.ts e2e/learning-cards.spec.ts e2e/extractions.spec.ts",
    "test:e2e:live-mutating": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3001} playwright test e2e/feed/discovery.spec.ts e2e/projects.spec.ts e2e/settings/authors.spec.ts e2e/settings/automation.spec.ts e2e/settings/ingestion.spec.ts e2e/settings/sources.spec.ts e2e/settings/templates.spec.ts e2e/settings/topics.spec.ts",
    "lint": "tsc --noEmit",
    "codegen:paper": "openapi-typescript http://localhost:${PAPER_INGESTION_HOST_PORT:-8010}/openapi.json -o src/types/paper-ingestion.gen.ts",
    "codegen:learning": "openapi-typescript http://localhost:${LEARNING_ENGINE_HOST_PORT:-8011}/openapi.json -o src/types/learning-engine.gen.ts",
    "codegen": "npm run codegen:paper && npm run codegen:learning"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "openapi-typescript": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
