{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "index.html",
    "vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/**/*.test.{ts,tsx}",
    "src/**/__tests__/**",
    "src/__mocks__/**"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true
}
