# docker-compose.override.yml.example
# ─────────────────────────────────────────────────────────────────────────────
# Per-machine override template. Copy to docker-compose.override.yml (gitignored)
# and customise for your local setup. setup.sh never reads, moves, or overwrites
# this file — it is yours; compose auto-loads it and .env/DASHBOARD_BIND_HOST
# governs the dashboard port binding.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Example: point the `ollama` service at a shared Ollama daemon that lives on an
# external Docker network, instead of running a per-project ollama instance. The
# socat container bridges the project's `jarvis` network to the external network
# the shared daemon listens on. Replace `shared-ollama-net` with the name of
# your own external network.
#
# Only the socat pattern is shown here. Add further service overrides below as
# needed for your machine (e.g. extra port bindings, GPU resource changes).
# ─────────────────────────────────────────────────────────────────────────────

services:
  ollama:
    # Replace the local ollama service with a socat proxy to the shared daemon.
    # alpine/socat:1.8.0.0 pinned for reproducibility.
    image: alpine/socat:1.8.0.0@sha256:a6be4c0262b339c53ddad723cdd178a1a13271e1137c65e27f90a08c16de02b8
    command: TCP-LISTEN:11434,fork,reuseaddr TCP:ollama:11434
    networks:
      - jarvis
      - shared-ollama-net
    restart: unless-stopped

networks:
  shared-ollama-net:
    external: true
    name: shared-ollama-net
