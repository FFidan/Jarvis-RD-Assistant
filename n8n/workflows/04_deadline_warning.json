{
  "name": "JARVIS Deadline Warning",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 12,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "node-1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.name, m.deadline, p.name AS project_name FROM milestones m JOIN projects p ON m.project_id = p.id WHERE m.completed = FALSE AND m.deadline <= NOW() + INTERVAL '3 days' AND m.deadline > NOW()",
        "options": {}
      },
      "id": "node-2",
      "name": "Upcoming Milestones",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [500, 300],
      "credentials": {
        "postgres": {
          "id": "jarvis_postgres",
          "name": "jarvis_postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-3",
      "name": "Has Results",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "jsCode": "const milestones = $('Upcoming Milestones').all().map(i => i.json);\nlet msg = '--- Deadline Warning ---\\n\\n';\nmsg += `${milestones.length} milestone(s) due within 3 days:\\n\\n`;\nmilestones.forEach(m => {\n  const deadline = new Date(m.deadline).toLocaleDateString();\n  msg += `  - ${m.name} [${m.project_name}]\\n    Due: ${deadline}\\n`;\n});\nreturn [{ json: { message: msg } }];"
      },
      "id": "node-4",
      "name": "Format Warning",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "node-5",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1250, 200],
      "credentials": {
        "telegramApi": {
          "id": "jarvis_telegram",
          "name": "jarvis_telegram"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Upcoming Milestones", "type": "main", "index": 0 }]]
    },
    "Upcoming Milestones": {
      "main": [[{ "node": "Has Results", "type": "main", "index": 0 }]]
    },
    "Has Results": {
      "main": [
        [{ "node": "Format Warning", "type": "main", "index": 0 }],
        []
      ]
    },
    "Format Warning": {
      "main": [[{ "node": "Send Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
