{
  "name": "JARVIS Research Pulse",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "node-1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM topics WHERE enabled = TRUE",
        "options": {}
      },
      "id": "node-2",
      "name": "Enabled Topics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [500, 300],
      "credentials": {
        "postgres": {
          "id": "jarvis_postgres",
          "name": "jarvis_postgres"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-3",
      "name": "SplitInBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [750, 300]
    },
    {
      "parameters": {
        "url": "http://paper_ingestion:8000/api/search",
        "method": "POST",
        "body": {
          "json": {
            "query": "={{ $json.query_terms || $json.name }}",
            "source": "arxiv",
            "max_results": 5
          }
        },
        "options": {},
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.JARVIS_API_KEY}}"
            }
          ]
        }
      },
      "id": "node-4",
      "name": "Search Papers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "url": "=http://paper_ingestion:8000/api/download-pdf/{{ $json.papers[0].id || $json.results[0].id }}",
        "method": "POST",
        "options": {},
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.JARVIS_API_KEY}}"
            }
          ]
        }
      },
      "id": "node-5",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "url": "=http://paper_ingestion:8000/api/process-pdf/{{ $json.paper_id || $json.id }}",
        "method": "POST",
        "options": {},
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.JARVIS_API_KEY}}"
            }
          ]
        }
      },
      "id": "node-6",
      "name": "Process PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "url": "=http://paper_ingestion:8000/api/summarize/{{ $json.paper_id || $json.id }}",
        "method": "POST",
        "options": {},
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.JARVIS_API_KEY}}"
            }
          ]
        }
      },
      "id": "node-7",
      "name": "Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1750, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet msg = '--- Research Pulse ---\\n\\n';\nmsg += `Processed ${items.length} paper(s) today.\\n\\n`;\n\nfor (const item of items) {\n  const data = item.json;\n  msg += `Title: ${data.title || 'Unknown'}\\n`;\n  if (data.summary) {\n    const short = data.summary.substring(0, 200);\n    msg += `Summary: ${short}...\\n`;\n  }\n  msg += '\\n';\n}\n\nreturn [{ json: { message: msg } }];"
      },
      "id": "node-8",
      "name": "Format Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "node-9",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2250, 300],
      "credentials": {
        "telegramApi": {
          "id": "jarvis_telegram",
          "name": "jarvis_telegram"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Enabled Topics", "type": "main", "index": 0 }]]
    },
    "Enabled Topics": {
      "main": [[{ "node": "SplitInBatches", "type": "main", "index": 0 }]]
    },
    "SplitInBatches": {
      "main": [
        [{ "node": "Search Papers", "type": "main", "index": 0 }],
        [{ "node": "Format Briefing", "type": "main", "index": 0 }]
      ]
    },
    "Search Papers": {
      "main": [[{ "node": "Download PDF", "type": "main", "index": 0 }]]
    },
    "Download PDF": {
      "main": [[{ "node": "Process PDF", "type": "main", "index": 0 }]]
    },
    "Process PDF": {
      "main": [[{ "node": "Summarize", "type": "main", "index": 0 }]]
    },
    "Summarize": {
      "main": [[{ "node": "SplitInBatches", "type": "main", "index": 0 }]]
    },
    "Format Briefing": {
      "main": [[{ "node": "Send Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
